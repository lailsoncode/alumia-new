GOOGLE_CLOUD_PROJECT="alumia-app"
GOOGLE_CLOUD_LOCATION="global"
ALUMIA_AI_MODEL="gemini-3.5-flash-lite"
GOOGLE_CLOUD_SPEECH_LOCATION="global"
ALUMIA_TTS_MODEL="gemini-2.5-flash-tts"
ALUMIA_TTS_VOICE="Aoede"
ALUMIA_TTS_PROMPT="Fale como a Alumia: uma mulher brasileira acolhedora, serena e próxima. Use um sotaque nordestino leve e natural, inspirado na fala de Recife, sem caricatura nem exagero. Mantenha ritmo calmo, dicção clara e calor humano, como uma conversa cuidadosa entre amigas."
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
ALLOWED_ORIGINS="http://localhost:8080,https://localhost,capacitor://localhost"
RATE_LIMIT_REQUESTS="12"
RATE_LIMIT_VOICE_REQUESTS="12"
RATE_LIMIT_WINDOW_MS="60000"
PORT="8080"
